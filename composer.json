{
    "name": "blconseils/niimbotlabels",
    "type": "glpi-plugin",
    "description": "Export Excel pour étiquettes Niimbot depuis GLPI, à partir de requêtes paramétrables",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "phpoffice/phpspreadsheet": "^1.29 || ^2.0"
    },
    "autoload": {
        "psr-4": {
            "GlpiPlugin\\Niimbotlabels\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
